# Required: DeepSeek API key.
# If unset, the key saved through the web UI (stored in data/agent.db) is used.
DEEPSEEK_API_KEY=

# Server host/port. These are read by the launchers (run.sh / `myriadcode`) as
# shell environment variables, NOT from .env -- export them before running:
#   HOST=127.0.0.1 PORT=8080 ./run.sh
# HOST=127.0.0.1
# PORT=8080

# Speech to text. The model is a name, not a path: faster-whisper downloads it
# on first use. tiny.en / base.en / small.en / medium.en / large-v3-turbo, or a
# local CTranslate2 directory. Device is detected -- CUDA if it works, else CPU.
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE=float16

# Agent limits
# MAX_TOOL_RESULT_CHARS=50000
# COMPACT_THRESHOLD_TOKENS=262144
# UPLOAD_DIR=/tmp/codeagent_uploads
