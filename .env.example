# Required: DeepSeek API key.
# If unset, the key saved through the web UI (stored in data/agent.db) is used.
DEEPSEEK_API_KEY=

# Server
# HOST=127.0.0.1
# PORT=8080

# Speech to text (auto-detected if whisper-cli / ffmpeg are on PATH)
# WHISPER_BIN=/usr/bin/whisper-cli
# WHISPER_MODEL=/home/you/opt/whisper.cpp/models/ggml-base.en.bin
# FFMPEG_BIN=/usr/bin/ffmpeg

# Vision (the `vision` and `screenshot` tools, and image attachments)
# VISION_OLLAMA_URL=
# VISION_MODEL=qwen3-vl:32b
# VISION_TIMEOUT=300
# VISION_MAX_PIXELS=2560000
# Hold the model in memory between calls. Ollama unloads after five minutes by
# default, and reloading a 32B vision model costs about ten seconds.
# VISION_KEEP_ALIVE=30m
# Must match on every request: changing it makes Ollama reload the model.
# VISION_NUM_CTX=8192
# The rig is started on demand over SSH, so the only thing to switch on by hand
# is the machine. Needs key-based SSH; runs as your user, no sudo.
# VISION_SSH_HOST=
# VISION_REMOTE_BIN=~/.local/bin/ollama
# VISION_AUTOSTART=1
# VISION_START_TIMEOUT=45

# Agent limits
# MAX_TOOL_ROUNDS=40
# MAX_TOOL_RESULT_CHARS=50000
# COMPACT_THRESHOLD_TOKENS=262144
# UPLOAD_DIR=/tmp/codeagent_uploads
